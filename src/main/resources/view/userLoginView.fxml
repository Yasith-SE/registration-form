<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="376.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.userLoginController">
   <children>
      <ImageView fitHeight="454.0" fitWidth="660.0" layoutX="-1.0" layoutY="-3.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images.jpg" />
         </image>
      </ImageView>
      <Label layoutX="529.0" layoutY="28.0" text="User login">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <JFXTextField fx:id="txtEmail" layoutX="195.0" layoutY="116.0" prefHeight="26.0" prefWidth="269.0" promptText=" Enter Email" />
      <JFXTextField fx:id="txtPassword" layoutX="195.0" layoutY="173.0" prefHeight="26.0" prefWidth="269.0" promptText=" Enter password" />
      <Button layoutX="201.0" layoutY="261.0" mnemonicParsing="false" onAction="#btnSignInOnAction" prefHeight="34.0" prefWidth="93.0" style="-fx-background-color: #0a5193;" text="Sign in" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button layoutX="399.0" layoutY="26.0" mnemonicParsing="false" onAction="#btnCreateAccount" prefHeight="30.0" prefWidth="124.0" style="-fx-background-color: cyan;" text="Create account">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label fx:id="lblValidation" layoutX="355.0" layoutY="267.0" prefHeight="27.0" prefWidth="146.0">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
