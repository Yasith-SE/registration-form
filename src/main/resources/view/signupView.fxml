<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="440.0" prefWidth="670.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.signupController">
   <children>
      <ImageView fitHeight="444.0" fitWidth="322.0" layoutX="1.0" layoutY="-4.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@signupp.png" />
         </image>
      </ImageView>
      <Label layoutX="570.0" layoutY="25.0" text="Sign Up">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <JFXTextField fx:id="txtFirstName" layoutX="330.0" layoutY="78.0" prefHeight="26.0" prefWidth="162.0" promptText="Enter First Name" />
      <JFXTextField fx:id="txtLastName" layoutX="330.0" layoutY="127.0" prefHeight="26.0" prefWidth="162.0" promptText="Enter Last Name" />
      <JFXTextField fx:id="txtEmailAddress" layoutX="330.0" layoutY="173.0" prefHeight="26.0" prefWidth="162.0" promptText="Enter Email Address" />
      <JFXTextField fx:id="txtPassword" layoutX="330.0" layoutY="220.0" prefHeight="26.0" prefWidth="162.0" promptText="Enter Password" />
      <JFXTextField fx:id="txtConfirmPassword" layoutX="330.0" layoutY="272.0" prefHeight="26.0" prefWidth="162.0" promptText="Confirm Password" />
      <Button layoutX="340.0" layoutY="372.0" mnemonicParsing="false" onAction="#btnRegister" prefHeight="30.0" prefWidth="84.0" style="-fx-background-color: skyblue;" text="Register">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="452.0" layoutY="23.0" mnemonicParsing="false" onAction="#btnBackToLogin" prefHeight="30.0" prefWidth="112.0" style="-fx-background-color: skyblue;" text="Back to login">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label fx:id="lblSignValidation" layoutX="478.0" layoutY="371.0" prefHeight="26.0" prefWidth="154.0" style="-fx-background-color: lightgray;" />
      <Label fx:id="lblEmailValidation" layoutX="504.0" layoutY="173.0" prefHeight="26.0" prefWidth="154.0" style="-fx-background-color: lightgray;" />
   </children>
</AnchorPane>
